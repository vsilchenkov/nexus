{
  "permissions": {
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(rm *-Recurse*)",
      "PowerShell(rmdir *-Recurse*)",
      "PowerShell(del *-Recurse*)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force-with-lease*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "PowerShell(git clean -f*)",
      "Bash(git branch -D*)",
      "PowerShell(git branch -D*)",
      "Bash(git checkout .*)",
      "Bash(git checkout -- *)",
      "Bash(git restore .*)",
      "Bash(git restore --source*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git rebase -i*)",
      "Bash(git filter-branch*)",
      "Bash(git update-ref -d*)",
      "Bash(git tag -d*)",
      "Bash(git push *--delete*)",
      "Bash(git push *:refs/heads/master*)",
      "Bash(git push *:refs/heads/main*)",

      "Bash(docker-compose down*-v*)",
      "Bash(docker compose down*-v*)",
      "Bash(docker-compose down*--volumes*)",
      "Bash(docker compose down*--volumes*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(docker network prune*)",
      "Bash(docker image prune*-a*)",
      "Bash(docker rm -f*)",
      "Bash(docker rmi -f*)",
      "PowerShell(docker-compose down*-v*)",
      "PowerShell(docker compose down*-v*)",
      "PowerShell(docker volume rm*)",
      "PowerShell(docker volume prune*)",
      "PowerShell(docker system prune*)",

      "Bash(*DROP DATABASE*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP SCHEMA*)",
      "Bash(*TRUNCATE*)",
      "PowerShell(*DROP DATABASE*)",
      "PowerShell(*DROP TABLE*)",
      "PowerShell(*DROP SCHEMA*)",
      "PowerShell(*TRUNCATE*)",
      "Bash(dropdb*)",
      "Bash(psql *-c *DROP*)",
      "Bash(psql *-c *TRUNCATE*)",
      "Bash(clickhouse-client *DROP*)",
      "Bash(clickhouse-client *TRUNCATE*)",

      "Write(.git/*)",
      "Edit(.git/*)",
      "Write(.claude/settings.json)",

      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(halt*)",
      "Bash(poweroff*)",
      "PowerShell(Stop-Computer*)",
      "PowerShell(Restart-Computer*)",
      "Bash(kill -9 1*)",
      "Bash(killall*)",
      "Bash(mkfs*)",
      "Bash(dd if=*of=/dev/*)",
      "Bash(chmod -R 777 *)",
      "Bash(chown -R *)"
    ]
  }
}
