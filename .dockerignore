# Исключения из контекста сборки Docker (context = корень репозитория).
#
# ВАЖНО: .git НЕ исключаем — он нужен в builder-стейдже для `git describe`
# (версия вшивается из git, см. deploy/docker/*.Dockerfile). Без .git версия
# деградирует до fallback 0.0.0-dev.

# Зависимости и сборочные артефакты фронта (SPA уже встроен в бинарь через
# embed.FS из internal/web/static — node_modules/dist для go build не нужны).
web-ui/node_modules
web-ui/dist

# Артефакты Go-сборки и релиза
bin/
dist/

# Локальные секреты и боевой конфиг (в образ кладётся config.example.yml явным
# COPY; .env передаётся в рантайме через env_file, а не в образ).
.env
.env.*
config/config.yml

# Рабочий каталог оператора: дампы БД и архивы (DEPLOYMENT §9.5). В образ им нельзя —
# builder-стейдж копирует дерево целиком, и выгрузка боевой БД осела бы в слое образа.
#
# Исключается СОДЕРЖИМОЕ, но не сам README: он ОТСЛЕЖИВАЕТСЯ git'ом, и без него в
# builder-стейдже `git describe --dirty` считает дерево грязным — версия уезжает
# как vX.Y.Z-dirty при полностью чистом `git status` на сервере (тот же эффект,
# что описан ниже для .env.example и .vscode/*.json; в v1.22.2 на этом и погорели).
deploy/arc/*
!deploy/arc/README.md

# Страховка на случай дампа, снятого в корне проекта. Маска только на КОРЕНЬ:
# migrations/*.sql обязаны попасть в образ — миграции применяются на старте сервисов.
/*.sql

# Тестовое и служебное
coverage.out
coverage.html
*.log
logs/
.idea/
.vscode/

# §9.4 (ложный «-dirty» в версии): .env.example и .vscode/*.json ОТСЛЕЖИВАЮТСЯ
# git'ом. Если оставить их под исключениями выше (.env.* / .vscode/), то в
# builder-стейдже после `COPY . .` они отсутствуют → `git describe --dirty`
# считает дерево грязным → версия уезжает как vX.Y.Z-dirty ДАЖЕ при чистом
# git status на сервере. `git update-index --refresh` это НЕ чинит (файлы реально
# отсутствуют, а не просто mtime). Возвращаем их в контекст сборки — в финальный
# образ они не попадают (builder-only, образ берёт лишь /out/<bin> + явные COPY).
!.env.example
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
