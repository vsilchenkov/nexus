    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}\\app\\cmd\\bus\\main.go",
            "args": ["-config=config/config_debug.yml"],
            "envFile": "${workspaceFolder}\\.env"
        },
        {
            "name": "Debug Integration Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${file}",
            "buildFlags": "-tags=integration",
            "args": [
                // "./...",
                "-test.v",
                // "-tags=integration",
                // "-test.run", "TestYourTest"
            ],
            "env": {
                "WS_WAIT_SECONDS": "3"
            },
            // "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Production",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}\\app\\cmd\\bus\\main.go",
            "args": [],
            "envFile": "${workspaceFolder}\\.env"
        },       
    ]
}