# Nexus — секреты. Реальный .env в git не коммитится.

# Версия (подставляется в build.version)
VERSION=0.1.0

# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_USER=nexus
PG_PASSWORD=change_me_in_production

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# ClickHouse
CH_HOST=clickhouse
CH_PORT=9000
CH_USER=default
CH_PASSWORD=

# Kafka
KAFKA_BROKERS=kafka:9092

# Sentry (см. §14.2 ТЗ)
SENTRY_USE=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Шифрование чувствительных полей в БД (см. §5.5 ТЗ)
# 32 байта в base64. Сгенерировать: openssl rand -base64 32
ENCRYPTION_KEY=replace_me_with_base64_32_bytes
