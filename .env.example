# Nexus — секреты. Реальный .env в git не коммитится.
# Шаблон ниже соответствует placeholder'ам в config/config_debug.yml
# (локальная отладка) и config.example.yml (prod).

# Версия приложения берётся из git при сборке (ldflags, §9.0) — задавать здесь НЕ нужно.
# Registry-путь деплоя убран (DEPLOYMENT.md §9.2), поэтому VERSION/REGISTRY_BASE больше
# не используются — деплой идёт сборкой из исходников на сервере (§9.1).

# Идентификатор ноды (§70). Пусто = единственная/первая нода: имена БД ClickHouse
# прежние (nexus_<slug>), теги и метки не добавляются. Для второй ноды на ОБЩЕМ
# ClickHouse задайте 1..8 символов (^[a-z][a-z0-9]{0,7}$), например kz → базы
# nexus_kz_<slug>. Менять после первого запуска нельзя (DEPLOYMENT.md §5А).
NEXUS_INSTANCE_ID=
# Аварийно: разрешить присвоить существующие БД без маркера владения — например,
# если PostgreSQL пересоздали, а ClickHouse остался. Чужой маркер не перебивает.
NEXUS_ADOPT=false

# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=nexus
PG_USER=nexus
PG_PASSWORD=change_me_in_production

# Redis (если используется ACL — задать REDIS_USER, иначе оставить пустым)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=
REDIS_PASSWORD=

# ClickHouse
CH_HOST=clickhouse
CH_PORT=9000
CH_DATABASE=vika_logs
CH_USER=default
CH_PASSWORD=

# Kafka
KAFKA_BROKERS=kafka:9092
# Для single-broker (dev / CI loadtest) → 1/1. На multi-broker prod-кластере: 3/2.
KAFKA_TOPIC_REPLICATION_FACTOR=3
KAFKA_TOPIC_MIN_INSYNC_REPLICAS=2
# JVM heap брокера. Значение по умолчанию в compose — -Xmx1G -Xms1G (столько же
# подставляет сам kafka-server-start.sh). На сервере с 2 ГБ памяти ставьте
# -Xmx512m -Xms256m: контейнер займёт ~515 МиБ вместо ~1.2 ГБ (DEPLOYMENT.md §5.4).
KAFKA_HEAP_OPTS=-Xmx1G -Xms1G

# Receiver URL (Web использует для replay-вызовов)
RECEIVER_URL=http://receiver:8080

# Prometheus — источник метрик дашбордов Web-панели (§21).
# Пусто → метрики панели деградируют (KPI/очередь/графики недоступны).
PROMETHEUS_URL=http://prometheus:9090
# Глубина хранения метрик в Prometheus (--storage.tsdb.retention.time).
# Влияет на доступную историю графиков/KPI и на объём тома prometheus_data.
PROMETHEUS_RETENTION=90d

# Sentry (см. §14.2 ТЗ)
SENTRY_USE=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# OpenTelemetry (§16 ТЗ, Phase 8.2)
OTEL_ENABLE=false
OTEL_OTLP_ENDPOINT=otel-collector:4318
OTEL_OTLP_INSECURE=true
OTEL_SAMPLE_RATE=0.1
OTEL_SERVICE_NAME=
OTEL_ENVIRONMENT=production

# Шифрование чувствительных полей в БД (см. §5.5 ТЗ)
# 32 байта в base64. Сгенерировать: openssl rand -base64 32
ENCRYPTION_KEY=replace_me_with_base64_32_bytes
