# Build output
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
out.*
profile
coverage.html
coverage.txt
*.syso

# Логи
*.log
/logs/

# IDE
.idea/

# Секреты в git не коммитятся. config/config.yml — НЕ секрет и версионируется:
# все чувствительные значения в нём это плейсхолдеры ${PG_PASSWORD}, ${CH_PASSWORD},
# ${SENTRY_DSN} и т.п., которые Compose подставляет из .env. Раньше файл был в
# игноре, и каждый новый ключ приходилось переносить на боевой сервер руками —
# при этом расхождение репозитория с боем ничем не проверялось (так §93 и нашёл
# topic.max_message_bytes 64 МиБ против брокерских 16 МиБ).
.env
# Стендовые варианты (.env.stand для deploy/docker-compose.stand-ha.yml) — тоже
# с реальными паролями локальных зависимостей.
.env.*

# Docker Compose — локальные per-server оверрайды (напр. внешний PG вместо
# bundled-контейнера на прод-сервере). Окружение-специфичны, в git не коммитятся.
# Путь якорный (ведущий "/"), поэтому игнорируется ТОЛЬКО файл в корне — тот,
# что Compose подхватывает автоматически. Готовые шаблоны в deploy/ (например
# deploy/docker-compose.override.yml — профиль сервера 2 ГБ / 2 ядра) под это
# правило не попадают и коммитятся.
/docker-compose.override.yml

# Web UI build output
/web-ui/dist/
/web-ui/node_modules/
# Корневой node_modules появляется, если vitest/npx запустили из корня репозитория
# (в нём оседает кеш .vite) — в дереве проекта ему места нет.
/node_modules/
/web-ui/tsconfig.tsbuildinfo

# protoc WKT — копируется локально при необходимости, в репо не нужно
/proto/google/

# Playwright MCP — каталог вывода (скриншоты/снапшоты), браузеры в user-кеше
/.playwright-mcp/

# Delve debug-бинарники (go test/debug) — суффикс после .exe не ловится *.exe
__debug_bin*

# QA-артефакты ручного тестирования — рабочие файлы, в репо не коммитятся
/specs/*.xlsx

# OS
.DS_Store
Thumbs.db

# Локальный тестовый стенд (бинари/логи/cookies) — не коммитим
.stand_bin/
/scratchbin/
# Временные хелперы стенда (напр. конфиг Prometheus под нативный запуск) и
# скриншоты браузерной верификации в корне — одноразовые, в репо не нужны.
/.stand-*.yml
# deploy/arc — рабочий каталог оператора для дампов и архивов (DEPLOYMENT §9.5).
# Сам каталог отслеживается через README (существует сразу после clone, чтобы
# перенаправление `> deploy/arc/…` не падало), содержимое — нет.
/deploy/arc/*
!/deploy/arc/README.md

# Страховка на случай дампа, снятого по старой привычке в корне проекта.
# Маска только на корень: migrations/*.sql отслеживаются.
/nexus_*.sql

/*.png

# Бэкапы исходников (напр. *.go.bak от рефакторинга) — не компилируются Go,
# но пару раз случайно попадали в коммит через `git add <dir>`.
*.bak

# Рабочая папка выпуска релизов — заготовки описаний (desc_NNN.md) одноразовые,
# в репо не нужны. Переиспользуемый хелпер вынесен в scripts/release/.
.release_tmp/
