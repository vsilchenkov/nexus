{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Kafka и async-конвейер Nexus: lag по группам/топикам, produced→delivered→failed, ошибки async по узлам, DLQ reprocess, loop-detection. ClickHouse-панели живут в дашборде Overview.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "tags": ["nexus"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "label": "Datasource",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(nexus_requests_total{method=\"requestAsync\"}, node)",
        "hide": 0,
        "includeAll": true,
        "label": "Node",
        "multi": true,
        "name": "node",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(nexus_requests_total{method=\"requestAsync\"}, node)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Nexus — Kafka & Async",
  "uid": "nexus-kafka",
  "version": 1,
  "schemaVersion": 39,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "title": "Consumer lag by group/topic/partition",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "description": "Отставание консьюмера по группам (nexus-sender / retry) и партициям. Линия 10k — порог алерта NexusKafkaLagHigh.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 10000 }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (group, topic, partition) (nexus_kafka_lag)",
          "legendFormat": "{{group}} {{topic}}/{{partition}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Sender in-flight messages",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "description": "Сообщения, вытянутые из Kafka, но ещё не закоммиченные (обрабатываются).",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "max(nexus_kafka_in_flight{component=\"sender\"})",
          "legendFormat": "in-flight",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Produce duration p95 by topic",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (topic, le) (rate(nexus_kafka_produce_duration_seconds_bucket[5m])))",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Async pipeline: produced vs delivered vs failed",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "description": "produced (enqueue на Receiver) vs delivered attempts (Sender) vs failed (non-2xx). Разрыв produced↔delivered = растёт backlog (сверять с панелью lag).",
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failed (non-2xx)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(rate(nexus_requests_total{service=\"receiver\",method=\"requestAsync\"}[5m]))",
          "legendFormat": "produced (receiver)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(nexus_requests_total{service=\"sender\",method=\"requestAsync\"}[5m]))",
          "legendFormat": "delivered attempts (sender)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(nexus_request_incomplete_total{service=\"sender\",method=\"requestAsync\"}[5m]))",
          "legendFormat": "failed (non-2xx)",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "title": "Async errors by node (sender, top 10)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": {
        "legend": { "calcs": ["max", "lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "topk(10, sum by (node) (rate(nexus_request_incomplete_total{service=\"sender\",method=\"requestAsync\",node=~\"$node\"}[5m])))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Cancelled async requests by node",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "description": "Async-запросы, отменённые оператором (status=cancelled), за 5-минутными окнами.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (node) (increase(nexus_requests_total{status=\"cancelled\",node=~\"$node\"}[5m]))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "DLQ reprocess outcomes",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "description": "Исходы повторной обработки из DLQ. ttl_dropped/dropped = безвозвратная потеря сообщения.",
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "succeeded" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "ttl_dropped" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "dropped" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "skipped" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(nexus_dlq_reprocess_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "DLQ reprocess sweep duration p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nexus_dlq_reprocess_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Loop detections by mode",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 23 },
      "description": "Запросы, отклонённые защитой от петель (X-Nexus-Hops), по режиму sync/async.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (mode) (increase(nexus_loop_detected_total[5m]))",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    }
  ]
}
