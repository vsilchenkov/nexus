{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Per-node health: проблемные узлы сразу видны, отправлено/ошибки/латентность по каждому узлу, RabbitMQ pull-узлы. Источник — /metrics всех сервисов (см. §6 ТЗ). Исходы доставки берутся со стороны Sender.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "tags": ["nexus"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "label": "Datasource",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(nexus_requests_total{service=\"sender\"}, node)",
        "hide": 0,
        "includeAll": true,
        "label": "Node",
        "multi": true,
        "name": "node",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(nexus_requests_total{service=\"sender\"}, node)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Nexus — Nodes",
  "uid": "nexus-nodes",
  "version": 1,
  "schemaVersion": 39,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "title": "Nodes DOWN",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "description": "Число узлов, чей последний исходящий запрос завершился transport-ошибкой или 5xx (gauge=2).",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(max by (node) (nexus_node_last_request_error) == 2) or vector(0)",
          "instant": true,
          "legendFormat": "down",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Nodes DEGRADED",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "description": "Число узлов, чей последний исходящий запрос вернул non-2xx < 500 (gauge=1) — узел жив, но отвечает ошибками.",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(max by (node) (nexus_node_last_request_error) == 1) or vector(0)",
          "instant": true,
          "legendFormat": "degraded",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Nodes OK",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "description": "Число узлов, чей последний исходящий запрос был успешным (2xx, gauge=0).",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "green" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(max by (node) (nexus_node_last_request_error) == 0) or vector(0)",
          "instant": true,
          "legendFormat": "ok",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Problem nodes (now)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "description": "Узлы с проблемой прямо сейчас (последний исходящий запрос не 2xx). Пустая таблица = все узлы здоровы.",
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Status", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "1": { "text": "DEGRADED", "color": "yellow", "index": 0 } } },
                  { "type": "value", "options": { "2": { "text": "DOWN", "color": "red", "index": 1 } } }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sort_desc(max by (node) (nexus_node_last_request_error) > 0)",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "Value": "Status" }
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Node summary (dashboard range)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 5 },
      "description": "Сводка по всем узлам за выбранный период: отправлено запросов, ошибок, % ошибок, p95 латентности, текущий статус. Столбцы ошибок подсвечиваются.",
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Errors", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Requests" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Errors" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Error %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 0.01 },
                    { "color": "red", "value": 0.05 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 0.2 },
                    { "color": "red", "value": 1 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "OK", "color": "green", "index": 0 } } },
                  { "type": "value", "options": { "1": { "text": "DEGRADED", "color": "yellow", "index": 1 } } },
                  { "type": "value", "options": { "2": { "text": "DOWN", "color": "red", "index": 2 } } }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (node) (increase(nexus_requests_total{service=\"sender\",node=~\"$node\"}[$__range]))",
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "expr": "sum by (node) (increase(nexus_request_incomplete_total{service=\"sender\",node=~\"$node\"}[$__range]))",
          "instant": true,
          "format": "table",
          "refId": "B"
        },
        {
          "expr": "sum by (node) (increase(nexus_request_incomplete_total{service=\"sender\",node=~\"$node\"}[$__range])) / sum by (node) (increase(nexus_requests_total{service=\"sender\",node=~\"$node\"}[$__range]))",
          "instant": true,
          "format": "table",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (node, le) (rate(nexus_request_duration_seconds_bucket{service=\"sender\",node=~\"$node\"}[$__range])))",
          "instant": true,
          "format": "table",
          "refId": "D"
        },
        {
          "expr": "max by (node) (nexus_node_last_request_error{node=~\"$node\"})",
          "instant": true,
          "format": "table",
          "refId": "E"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "node", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time 5": true
            },
            "renameByName": {
              "Value #A": "Requests",
              "Value #B": "Errors",
              "Value #C": "Error %",
              "Value #D": "p95",
              "Value #E": "Status"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "RPS by node (sender)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (node) (rate(nexus_requests_total{service=\"sender\",node=~\"$node\"}[5m]))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Errors by node (sender, top 15)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "description": "Скорость неуспешных доставок (non-2xx) по узлам, top-15.",
      "options": {
        "legend": { "calcs": ["max", "lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "topk(15, sum by (node) (rate(nexus_request_incomplete_total{service=\"sender\",node=~\"$node\"}[5m])))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "p95 latency by node (sender)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (node, le) (rate(nexus_request_duration_seconds_bucket{service=\"sender\",node=~\"$node\"}[5m])))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Node status history",
      "type": "state-timeline",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "description": "История исхода последнего запроса по узлам: видно, когда узел флапал.",
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "never",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 70, "lineWidth": 0 },
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OK", "color": "green", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "DEGRADED", "color": "yellow", "index": 1 } } },
            { "type": "value", "options": { "2": { "text": "DOWN", "color": "red", "index": 2 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (node) (nexus_node_last_request_error{node=~\"$node\"})",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "RMQ connection state (pull nodes)",
      "type": "state-timeline",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 31 },
      "description": "Состояние соединения RabbitMQAsync pull-узлов. Пусто, если pull-узлов нет.",
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "never",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 70, "lineWidth": 0 },
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "CONNECTING", "color": "yellow", "index": 1 } } },
            { "type": "value", "options": { "2": { "text": "UP", "color": "green", "index": 2 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (node) (nexus_rmq_connection_state{node=~\"$node\"})",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "RMQ queue depth / consumers",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "max by (node) (nexus_rmq_queue_depth{node=~\"$node\"})",
          "legendFormat": "{{node}} depth",
          "refId": "A"
        },
        {
          "expr": "max by (node) (nexus_rmq_consumer_count{node=~\"$node\"})",
          "legendFormat": "{{node}} consumers",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "title": "RMQ pulled messages by status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 38 },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*(nack|reject).*" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (node, status) (rate(nexus_rmq_messages_pulled_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{node}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Degraded pull nodes (receiver)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 38 },
      "description": "Pull-узлы, помеченные Receiver'ом как degraded, с причиной. Пусто = здоровы.",
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (node, reason) (nexus_node_degraded{node=~\"$node\"}) == 1",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true },
            "renameByName": {}
          }
        }
      ]
    }
  ]
}
